# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# General
[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{axaml,xaml}]
indent_size = 2

# dotnet specific
dotnet_sort_system_directives_first = true

# Debug views/view models live under a Debug/ subfolder but keep the flat
# MobileApp.Views / MobileApp.ViewModels namespace on purpose — ViewLocator.cs
# resolves views by namespace, not folder. Don't "fix" the namespace mismatch.
[src/MobileApp/{Views,ViewModels}/Debug/*.cs]
dotnet_diagnostic.IDE0130.severity = none
