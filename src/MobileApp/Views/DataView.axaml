<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MobileApp.ViewModels"
             xmlns:design="clr-namespace:MobileApp.ViewModels.Design"
             mc:Ignorable="d" d:DesignWidth="540" d:DesignHeight="960"
             Background="{DynamicResource Charcoal}"
             x:Class="MobileApp.Views.DataView"
             x:DataType="vm:DataViewModel">
  <Design.DataContext>
    <design:DesignDataViewModel />
  </Design.DataContext>

  <ScrollViewer>
    <StackPanel Margin="20 10 20 20" Spacing="10" Orientation="Vertical">

      <!-- Errors -->
      <Border Background="#FEF2F2"
              BorderBrush="#FECACA"
              BorderThickness="1"
              CornerRadius="8"
              Padding="16"
              IsVisible="{Binding HasErrors}">
        <ItemsControl ItemsSource="{Binding Errors}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding .}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="14" Foreground="#DC2626"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <!-- Accounts -->
      <Grid ColumnDefinitions="Auto, *, Auto, Auto" Margin="0 10">
        <TextBlock Text="Accounts" VerticalAlignment="Center" Margin="0 0 5 0" FontSize="18" FontWeight="DemiBold" Foreground="{DynamicResource PureWhite}"/>

        <Button Grid.Column="2" Command="{Binding OpenAuthPageCommand}" Background="{DynamicResource Lavender}"
                Foreground="{DynamicResource Charcoal}" FontWeight="DemiBold" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="15 0" Classes="accent-hover">
          <PathIcon Data="{DynamicResource AddCircleRegular}"/>
        </Button>

        <Button Grid.Column="3" Command="{Binding RefreshTokenCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="{DynamicResource Lavender}" Classes="accent-hover">
          <PathIcon Data="{StaticResource ArrowSyncCircleRegular}" Foreground="{DynamicResource Charcoal}"/>
        </Button>
      </Grid>

      <!-- Skeleton loading placeholders -->
      <StackPanel IsVisible="{Binding Loading}">
        <StackPanel.Styles>
          <Style Selector="Border.skeleton-block">
            <Setter Property="Background" Value="#CBD1DC"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="ClipToBounds" Value="True"/>
          </Style>
          <Style Selector="Border.shimmer-highlight">
            <Setter Property="Width" Value="160"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="RenderTransform">
              <TranslateTransform X="-160"/>
            </Setter>
            <Setter Property="Background">
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#00FFFFFF" Offset="0"/>
                <GradientStop Color="#F2FFFFFF" Offset="0.5"/>
                <GradientStop Color="#00FFFFFF" Offset="1"/>
              </LinearGradientBrush>
            </Setter>
            <Style.Animations>
              <Animation Duration="0:0:1.2" IterationCount="INFINITE">
                <KeyFrame Cue="0%">
                  <Setter Property="TranslateTransform.X" Value="-160"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                  <Setter Property="TranslateTransform.X" Value="240"/>
                </KeyFrame>
              </Animation>
            </Style.Animations>
          </Style>
        </StackPanel.Styles>
        <Border Background="{DynamicResource PureWhite}" CornerRadius="10" Margin="0 0 0 15" Padding="15">
          <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto">
            <Border Classes="skeleton-block" Grid.RowSpan="2" Width="64" Height="64" CornerRadius="8">
              <Border Classes="shimmer-highlight" Height="64"/>
            </Border>
            <Border Classes="skeleton-block" Grid.Row="0" Grid.Column="1" Width="120" Height="22" HorizontalAlignment="Right">
              <Border Classes="shimmer-highlight" Height="22"/>
            </Border>
            <Border Classes="skeleton-block" Grid.Row="1" Grid.Column="1" Width="160" Height="16" Margin="0 8 0 0" HorizontalAlignment="Right" VerticalAlignment="Bottom">
              <Border Classes="shimmer-highlight" Height="16"/>
            </Border>
          </Grid>
        </Border>
        <Border Background="{DynamicResource PureWhite}" CornerRadius="10" Margin="0 0 0 15" Padding="15">
          <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto">
            <Border Classes="skeleton-block" Grid.RowSpan="2" Width="64" Height="64" CornerRadius="8">
              <Border Classes="shimmer-highlight" Height="64"/>
            </Border>
            <Border Classes="skeleton-block" Grid.Row="0" Grid.Column="1" Width="120" Height="22" HorizontalAlignment="Right">
              <Border Classes="shimmer-highlight" Height="22"/>
            </Border>
            <Border Classes="skeleton-block" Grid.Row="1" Grid.Column="1" Width="160" Height="16" Margin="0 8 0 0" HorizontalAlignment="Right" VerticalAlignment="Bottom">
              <Border Classes="shimmer-highlight" Height="16"/>
            </Border>
          </Grid>
        </Border>
      </StackPanel>

      <!-- Balances -->
      <ItemsControl IsVisible="{Binding !Loading}" ItemsSource="{Binding Balances}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Click="OnBalanceCardClick" Background="Transparent" BorderThickness="0" CornerRadius="10" Padding="0" HorizontalContentAlignment="Stretch">
              <Border Background="{DynamicResource PureWhite}" CornerRadius="10" Margin="0 0 0 15" Padding="15">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto">
                    <!-- Logo -->
                    <Border Grid.RowSpan="2" Width="64" Height="64" BorderBrush="LightGray" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                      <Border.Background>
                        <ImageBrush Source="{Binding IconSource}" Stretch="UniformToFill"/>
                      </Border.Background>
                    </Border>

                    <!-- Account Info Section -->
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AvailableAmount}" HorizontalAlignment="Right"
                               FontWeight="Bold" FontSize="22" Foreground="{DynamicResource Charcoal}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Iban}"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                  </Grid>
                </StackPanel>
              </Border>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
